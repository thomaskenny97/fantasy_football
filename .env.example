# Sleeper needs only your username — the API is fully public, no auth.
SLEEPER_USERNAME=your_sleeper_username

# ESPN private leagues need cookies from your browser.
# Chrome: F12 > Application > Cookies > https://www.espn.com
# Copy the values of the SWID and espn_s2 cookies.
# Comma-separate multiple league IDs.
ESPN_LEAGUE_IDS=123456
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=

# Season to operate on. Leave blank to auto-detect from Sleeper's NFL state.
SEASON=

# Optional. Set this if the app cannot work out which team is yours - it happens when
# your league records an older ESPN identity than your current browser session.
# `python -m backend.cli teams` lists the ids.
ESPN_TEAM_ID=
